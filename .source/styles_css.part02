main{position:relative;z-index:2}.hero{position:relative;min-height:100svh;overflow:hidden;padding:7.3rem var(--pad) 2rem;background:radial-gradient(circle at 80% 35%,rgba(39,120,190,.16),transparent 30%),linear-gradient(180deg,rgba(7,9,10,.25),#07090a 90%)}.hero-grid,.contact-grid{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:5vw 5vw;mask-image:linear-gradient(to bottom,#000,transparent 93%)}.hero-meta{position:relative;z-index:3;display:flex;justify-content:space-between;color:#a5aaac;font-size:.57rem;letter-spacing:.11em;text-transform:uppercase}.hero-meta span:first-child{display:flex;align-items:center;gap:.55rem}.hero-meta i{width:7px;height:7px;border-radius:50%;background:var(--orange);box-shadow:0 0 18px var(--orange)}.hero-copy{position:relative;z-index:4;margin-top:9vh}.hero-eyebrow{margin:0 0 1rem;color:var(--blue-soft);font-size:.58rem;letter-spacing:.15em}.hero h1{position:relative;margin:0;font-family:var(--display);font-size:clamp(6.4rem,14.3vw,14.5rem);font-weight:800;line-height:.68;letter-spacing:-.065em;text-transform:uppercase}.hero-line{display:block;overflow:hidden}.hero-line b{display:block}.hero-line--offset{padding-left:7vw}.hero h1 em{color:var(--orange);font-style:normal;font-weight:400}.hero-bottom{width:min(42rem,46vw);margin:2.3rem 0 0 8vw}.hero-bottom>p{margin:0;color:#b7bbbc;font-size:.82rem;line-height:1.75}.hero-actions{display:flex;gap:.7rem;margin-top:1.5rem}.button{display:inline-flex;align-items:center;justify-content:center;gap:.7rem;min-height:48px;padding:.8rem 1.1rem;border:1px solid rgba(255,255,255,.26);font-size:.62rem;font-weight:650;letter-spacing:.09em;text-transform:uppercase;transition:.25s}.button--solid{border-color:var(--orange);background:var(--orange);color:#08090a}.button--solid:hover{background:#fff;border-color:#fff}.button--ghost:hover{border-color:var(--blue);color:var(--blue-soft)}.hero-visual{position:absolute;z-index:3;right:3vw;top:13%;width:min(41vw,760px);height:73vh;perspective:1100px}.hero-image-shell{position:absolute;inset:0;overflow:hidden;clip-path:polygon(12% 0,100% 0,100% 92%,88% 100%,0 100%,0 12%);border:1px solid rgba(255,255,255,.16);background:#090c0e;transform-style:preserve-3d;transition:transform .25s ease-out}.hero-image-shell img{width:100%;height:100%;object-fit:cover;object-position:center;filter:saturate(.95) contrast(1.06)}.hero-image-glass{position:absolute;inset:0;background:linear-gradient(100deg,rgba(255,255,255,.08),transparent 22%,transparent 72%,rgba(255,122,38,.08));mix-blend-mode:screen}.hero-image-scan{position:absolute;left:0;right:0;top:-5%;height:1px;background:var(--blue);box-shadow:0 0 20px var(--blue);animation:scan 4.5s linear infinite}@keyframes scan{to{top:105%}}.hero-chip{position:absolute;z-index:3;display:flex;align-items:center;gap:.6rem;padding:.7rem .8rem;border:1px solid rgba(255,255,255,.18);background:rgba(6,8,9,.72);backdrop-filter:blur(12px);font-size:.52rem;letter-spacing:.1em}.hero-chip span{color:var(--orange);font-size:.9rem}.hero-chip--top{left:-3rem;top:15%}.hero-chip--bottom{right:-1rem;bottom:8%}.hero-orbit{position:absolute;border:1px solid rgba(57,167,255,.19);border-radius:50%;pointer-events:none}.orbit-one{width:44vw;height:44vw;right:-12vw;top:1vh;animation:spin 27s linear infinite}.orbit-two{width:24vw;height:24vw;right:7vw;top:22vh;border-style:dashed;animation:spinReverse 18s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@keyframes spinReverse{to{transform:rotate(-360deg)}}.hero-scroll{position:absolute;left:var(--pad);bottom:1.5rem;display:flex;align-items:center;gap:1rem;color:#757b7e;font-size:.55rem;letter-spacing:.13em}.hero-scroll i{width:70px;height:1px;background:#555;overflow:hidden}.hero-scroll i:after{content:"";display:block;width:30%;height:100%;background:var(--orange);animation:scrollLine 1.8s ease-in-out infinite}@keyframes scrollLine{0%{transform:translateX(-100%)}100%{transform:translateX(350%)}}.hero-coordinate{position:absolute;right:var(--pad);bottom:1rem;color:#555b5e;font-size:.5rem;line-height:1.5;text-align:right}
.section-light{position:relative;background:var(--paper);color:#0b0d0e}.section-index{display:flex;align-items:center;gap:.7rem;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase}.section-index span{display:grid;place-items:center;width:28px;height:28px;border:1px solid currentColor;border-radius:50%;font-size:.52rem}.section-index p{margin:0}.statement{padding:9rem var(--pad) 0;overflow:hidden}.statement h2,.work-intro h2,.services-head h2,.process-left h2,.about-copy h2{margin:1.6rem 0;font-family:var(--display);font-size:clamp(4.7rem,9.3vw,9.4rem);font-weight:600;line-height:.78;letter-spacing:-.055em;text-transform:uppercase}.statement h2 em,.work-intro h2 em,.services-head h2 em,.about-copy h2 em{font-style:normal;color:#006f8c;font-weight:400}.split-reveal{overflow:hidden}.statement-grid{display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:start;margin:5rem 0 8rem;padding-left:32vw}.statement-grid>p{margin:0;color:#444b4c;font-size:.9rem;line-height:1.8}.statement-facts{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line-dark)}.statement-facts article{padding:1rem .7rem;border-right:1px solid var(--line-dark)}.statement-facts article:last-child{border:0}.statement-facts b{display:block;font-family:var(--display);font-size:3rem;font-weight:600}.statement-facts b:after{content:"+";color:#007895;font-size:1rem}.statement-facts article:nth-child(2) b:after{content:""}.statement-facts article:nth-child(3) b:after{content:"%"}.statement-facts span{font-size:.55rem;line-height:1.4;text-transform:uppercase}.kinetic-strip{margin-left:calc(var(--pad)*-1);margin-right:calc(var(--pad)*-1);overflow:hidden;border-top:1px solid #101212;border-bottom:1px solid #101212;background:#0b0d0e;color:var(--paper)}.kinetic-strip div{width:max-content;padding:.75rem 0;font-family:var(--display);font-size:1.25rem;font-weight:600;letter-spacing:.05em;animation:marquee 28s linear infinite}@keyframes marquee{to{transform:translateX(-50%)}}
