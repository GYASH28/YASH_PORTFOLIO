.case-modal{position:fixed;z-index:13000;inset:0;display:grid;place-items:end;visibility:hidden}.case-modal.is-open{visibility:visible}.case-backdrop{position:absolute;inset:0;border:0;background:rgba(0,0,0,.72);backdrop-filter:blur(9px);opacity:0;transition:opacity .45s}.case-modal.is-open .case-backdrop{opacity:1}.case-panel{position:relative;width:min(820px,95vw);height:100%;overflow-y:auto;padding:1rem;background:#101315;transform:translateX(105%);transition:transform .65s cubic-bezier(.16,1,.3,1)}.case-modal.is-open .case-panel{transform:none}.case-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:.8rem;color:var(--orange);font-size:.56rem;letter-spacing:.1em}.case-close{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(255,255,255,.18);background:none;font-size:1.4rem;cursor:pointer}.case-visual{position:relative;height:44vh;overflow:hidden;border:1px solid rgba(255,255,255,.15)}.case-visual img{width:100%;height:100%;object-fit:cover;object-position:top}.case-visual i{position:absolute;left:0;right:0;top:-5%;height:1px;background:var(--orange);box-shadow:0 0 20px var(--orange);animation:scan 3.5s linear infinite}.case-content{padding:2rem .4rem 3rem}.case-content>p:first-child{color:var(--blue-soft);font-size:.55rem;letter-spacing:.12em}.case-content h2{margin:.6rem 0;font-family:var(--display);font-size:clamp(4rem,8vw,7rem);font-weight:600;line-height:.78;text-transform:uppercase}.case-content>p:nth-of-type(2){max-width:650px;color:#b1b6b7;font-size:.78rem;line-height:1.75}.case-proof{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin:2rem 0}.case-proof span{padding:.8rem;border:1px solid rgba(255,255,255,.15);font-size:.58rem}.case-actions{display:flex;gap:.6rem}
.reveal{opacity:0;transform:translateY(32px);transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}.reveal.is-visible{opacity:1;transform:none}.split-reveal{opacity:0;transform:translateY(50px);transition:opacity 1s,transform 1.1s cubic-bezier(.16,1,.3,1)}.split-reveal.is-visible{opacity:1;transform:none}
@media(max-width:1100px){.hero h1{font-size:14vw}.hero-visual{right:1vw;width:44vw}.hero-bottom{width:48vw}.statement-grid{padding-left:12vw}.project-screen-wrap{left:3vw;width:58vw}.project-info{right:3vw;width:33vw}.about-collage{grid-template-columns:.7fr 1.3fr}.about-side-image{display:none}.service-output-copy{max-width:85%}}
@media(max-width:899px){.cursor{display:none}.site-header{height:64px;grid-template-columns:auto 1fr auto}.desktop-nav,.header-contact{display:none}.menu-toggle{display:flex;justify-self:end;flex-direction:column;gap:5px;width:42px;height:42px;align-items:center;justify-content:center;border:0;background:none}.menu-toggle span{width:20px;height:1px;background:#fff;transition:.3s}.menu-toggle.is-open span:first-child{transform:translateY(3px) rotate(45deg)}.menu-toggle.is-open span:last-child{transform:translateY(-3px) rotate(-45deg)}.mobile-menu{position:fixed;z-index:950;top:64px;left:0;right:0;height:calc(100svh - 64px);display:flex;flex-direction:column;padding:2rem var(--pad);background:var(--orange);color:#08090a;transform:translateY(-115%);transition:transform .65s cubic-bezier(.76,0,.24,1)}.mobile-menu.is-open{transform:none}.mobile-menu p{font-size:.58rem;text-transform:uppercase}.mobile-menu a{display:grid;grid-template-columns:2rem 1fr;align-items:center;padding:.3rem 0;border-bottom:1px solid rgba(0,0,0,.25);font-family:var(--display);font-size:13vw;text-transform:uppercase}.mobile-menu a span{font-family:var(--body);font-size:.55rem}.hero{min-height:960px}.hero-copy{margin-top:7rem}.hero h1{font-size:18vw}.hero-line--offset{padding-left:0}.hero-bottom{width:100%;margin:2rem 0}.hero-bottom>p{max-width:35rem}.hero-visual{top:51%;right:var(--pad);width:64vw;height:40vh}.hero-chip--top{left:-2rem}.statement-grid{grid-template-columns:1fr;padding-left:0}.project-story{height:auto}.project-stage{position:relative;height:auto;min-height:1150px;padding:6rem var(--pad) 8rem}.project-screen-wrap{position:relative;left:auto;top:auto;width:100%;height:52vw;min-height:340px}.project-info{position:relative;right:auto;top:auto;width:100%;margin-top:3rem}.project-nav{position:relative;left:auto;right:auto;bottom:auto;grid-template-columns:1fr 1fr;margin-top:3rem}.project-progress{display:none}.service-lab{grid-template-columns:1fr}.service-tabs{border-right:1px solid var(--line-dark);border-bottom:0}.service-output{min-height:640px}.process{height:auto}.process-sticky{position:relative;display:block;padding-top:7rem}.process-world{position:relative;left:auto;top:auto;width:80vw;height:80vw;margin:2rem auto;transform:none}.process-steps{margin-left:0}.process-step{opacity:1;transform:none}.about-collage{grid-template-columns:1fr 1.35fr;min-height:800px}.about-copy{padding:2.2rem}.contact{min-height:820px}}
@media(max-width:620px){:root{--pad:.9rem}.intro-mark{font-size:24vw}.intro-words span{font-size:18vw}.intro-status span:last-child{display:none}.hero{min-height:880px;padding-top:6rem}.hero-meta span:last-child{display:none}.hero-copy{margin-top:4.5rem}.hero h1{font-size:20vw}.hero-actions{align-items:flex-start;flex-direction:column}.hero-visual{top:55%;width:72vw;height:33vh}.hero-chip{display:none}.hero-coordinate{display:none}.statement{padding-top:6rem}.statement h2,.work-intro h2,.services-head h2,.process-left h2,.about-copy h2{font-size:17vw}.statement-grid{margin-top:3rem}.statement-facts{grid-template-columns:1fr}.statement-facts article{border-right:0;border-bottom:1px solid var(--line-dark)}.work-intro{padding-top:6rem}.project-stage{min-height:1040px}.project-screen-wrap{height:58vw;min-height:270px}.project-info h3{font-size:17vw}.project-nav{grid-template-columns:1fr}.project-nav button{border-right:0;border-bottom:1px solid rgba(255,255,255,.1)}.service-output{min-height:720px}.service-output-copy{max-width:100%;padding:1.2rem}.service-output-copy h3{font-size:15vw}.service-node{width:72px;height:72px}.service-node--one{left:6%;bottom:8%}.service-node--two{left:37%;bottom:17%}.service-node--three{right:8%;bottom:31%}.service-node--four{right:5%;bottom:5%}.process-sticky{padding-left:var(--pad);padding-right:var(--pad)}.process-world{width:95vw;height:95vw}.process-step h3{font-size:1.8rem}.about-collage{grid-template-columns:1fr;padding-top:.8rem}.about-main-image{height:480px;margin:0}.about-copy{padding:3rem .2rem}.contact{min-height:760px}.contact-top{gap:1rem}.contact-title{font-size:20vw}.contact-title span:last-child{padding-left:0}.contact-actions{align-items:flex-start;flex-direction:column}.contact-footer{grid-template-columns:1fr;gap:1rem}.case-panel{width:100%}.case-visual{height:33vh}.case-proof{grid-template-columns:1fr}}
@media(pointer:coarse){.cursor{display:none}}
