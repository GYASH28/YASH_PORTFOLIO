.process{position:relative;height:500vh;background:#07090a}.process-sticky{position:sticky;top:0;min-height:100svh;display:grid;grid-template-columns:1fr 1fr;padding:8rem var(--pad) 3rem;overflow:hidden}.process-left{position:relative;z-index:3;align-self:start}.process-left h2{color:#fff;font-size:clamp(4.3rem,7.2vw,7.2rem)}.process-left>p:last-child{max-width:31rem;color:#a6acad;font-size:.78rem;line-height:1.75}.process-world{position:absolute;left:47%;top:50%;width:48vw;height:48vw;transform:translate(-50%,-50%);pointer-events:none}.process-core{position:absolute;left:50%;top:50%;display:grid;place-items:center;width:130px;height:130px;border:1px solid var(--orange);border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 0 90px rgba(255,122,38,.15)}.process-core span{font-family:var(--display);font-size:1.2rem;letter-spacing:.08em}.process-core i{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--orange);box-shadow:0 0 18px var(--orange);animation:pulse 1.4s ease-in-out infinite}@keyframes pulse{50%{transform:scale(2.4);opacity:.25}}.process-ring{position:absolute;left:50%;top:50%;border:1px solid rgba(57,167,255,.25);border-radius:50%;transform:translate(-50%,-50%)}.process-ring--a{width:54%;height:54%;animation:spin 20s linear infinite}.process-ring--b{width:83%;height:83%;border-style:dashed;animation:spinReverse 28s linear infinite}.process-orbit-dot{position:absolute;left:50%;top:8%;width:10px;height:10px;border-radius:50%;background:var(--blue);box-shadow:0 0 20px var(--blue);transform-origin:0 42vw;animation:spin 13s linear infinite}.process-steps{position:relative;z-index:4;grid-column:2;align-self:center;margin-left:7vw}.process-step{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1.4rem 0;border-bottom:1px solid rgba(255,255,255,.12);opacity:.24;transform:translateX(25px);transition:.5s}.process-step.is-active{opacity:1;transform:none}.process-step>span{display:grid;place-items:center;width:38px;height:38px;border:1px solid rgba(255,255,255,.18);border-radius:50%;font-size:.52rem}.process-step.is-active>span{border-color:var(--orange);color:var(--orange)}.process-step h3{margin:0;font-family:var(--display);font-size:2.2rem;font-weight:600;text-transform:uppercase}.process-step p{max-width:29rem;margin:.45rem 0 0;color:#9fa5a6;font-size:.68rem;line-height:1.6}
.about{padding:1rem 0}.about-collage{display:grid;grid-template-columns:.8fr 1.35fr .65fr;min-height:940px}.about-main-image,.about-side-image{position:relative;overflow:hidden;background:#111}.about-main-image{margin-top:18rem}.about-main-image img,.about-side-image img{width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform .8s}.about-main-image:hover img,.about-side-image:hover img{transform:scale(1.035)}.about-main-image>span{position:absolute;left:.7rem;bottom:.7rem;padding:.5rem .6rem;background:#090b0c;color:var(--orange);font-size:.48rem;letter-spacing:.1em}.about-copy{align-self:center;padding:4rem}.about-copy h2{font-size:clamp(4.5rem,7.5vw,7.6rem)}.about-lead{font-size:1.05rem!important;font-weight:650;color:#111!important}.about-copy>p{max-width:48rem;color:#4b5253;font-size:.78rem;line-height:1.75}.about-links{display:flex;gap:.6rem;margin-top:2rem}.about-links a{display:flex;gap:.6rem;align-items:center;padding:.75rem .9rem;border:1px solid #0c0e0f;font-size:.58rem;text-transform:uppercase}.about-links a:hover{background:#0c0e0f;color:#fff}.about-side-image{height:64%;align-self:end}.about-side-image>div{position:absolute;left:.6rem;right:.6rem;bottom:.6rem;display:grid;gap:.15rem;padding:.75rem;background:rgba(7,9,10,.82);color:#fff;backdrop-filter:blur(10px)}.about-side-image span{color:var(--orange);font-size:.46rem;letter-spacing:.1em}.about-side-image b{margin-bottom:.45rem;font-size:.58rem}
.contact{position:relative;z-index:2;min-height:100svh;display:flex;flex-direction:column;justify-content:space-between;padding:2rem var(--pad);overflow:hidden;background:#07090a}.contact-grid{opacity:.85}.contact>*:not(.contact-grid){position:relative}.contact-top{display:flex;justify-content:space-between;color:#8e9496;font-size:.56rem;letter-spacing:.09em}.contact-title{margin:auto 0 2rem;font-family:var(--display);font-size:clamp(5.5rem,13.8vw,14rem);font-weight:800;line-height:.66;letter-spacing:-.065em;text-transform:uppercase}.contact-title span{display:block}.contact-title span:last-child{padding-left:8vw;color:var(--orange)}.contact-actions{display:flex;gap:.6rem}.contact-main,.copy-email{display:flex;align-items:center;justify-content:center;gap:.7rem;min-height:58px;padding:1rem 1.2rem;border:1px solid var(--orange);background:var(--orange);color:#08090a;font-size:.62rem;font-weight:700;letter-spacing:.09em;cursor:pointer}.copy-email{border-color:rgba(255,255,255,.23);background:transparent;color:#fff}.copy-email:hover{border-color:var(--blue);color:var(--blue-soft)}.contact-footer{display:grid;grid-template-columns:1fr auto auto;align-items:end;gap:3rem;margin-top:4rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.13);color:#848a8c;font-size:.54rem}.contact-footer>div{display:flex;flex-direction:column;gap:.25rem}.contact-footer>div:nth-child(2){flex-direction:row;gap:1rem}.contact-footer b{color:#fff}
