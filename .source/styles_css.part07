.hero:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 68% 48%,rgba(216,255,54,.085),transparent 30%),linear-gradient(115deg,transparent 0 55%,rgba(255,255,255,.025) 55% 56%,transparent 56%);pointer-events:none}
.hero-aurora{position:absolute;inset:0;pointer-events:none;filter:blur(35px);opacity:.55}
.hero-aurora i{position:absolute;border:1px solid rgba(216,255,54,.3);border-radius:50%;animation:aurora 14s ease-in-out infinite alternate}
.hero-aurora i:nth-child(1){width:40vw;height:40vw;right:-8vw;top:8vh}.hero-aurora i:nth-child(2){width:26vw;height:26vw;right:16vw;bottom:2vh;animation-delay:-5s}.hero-aurora i:nth-child(3){width:13vw;height:13vw;left:43%;top:18%;animation-delay:-9s}
@keyframes aurora{to{transform:translate3d(-4vw,5vh,0) scale(1.18) rotate(20deg);border-radius:36% 64% 58% 42%}}
.hero-sideword{position:absolute;right:20px;top:28%;writing-mode:vertical-rl;font:600 10px/1 var(--mono);letter-spacing:.35em;color:rgba(255,255,255,.42)}
.hero-copy{z-index:3}.hero-copy h1{font-size:clamp(4.7rem,11.6vw,12rem);line-height:.78;letter-spacing:-.075em;max-width:13ch}
.hero-line b{display:inline-block;text-shadow:0 1px 0 rgba(255,255,255,.1)}
.hero-line em{color:var(--acid);font-style:italic;font-family:Georgia,serif;font-weight:400;letter-spacing:-.09em}
.hero-eyebrow{color:var(--acid);letter-spacing:.22em}
.hero-bottom{max-width:700px}.hero-bottom>p{font-size:clamp(1rem,1.35vw,1.28rem);color:#d7dbd4}
.hero-image-shell{border-radius:48% 48% 5px 5px;overflow:hidden;transform:rotate(2.4deg);box-shadow:0 40px 100px rgba(0,0,0,.55),0 0 0 1px rgba(255,255,255,.12)}
.hero-image-shell:after{content:"";position:absolute;inset:0;background:linear-gradient(145deg,transparent 50%,rgba(216,255,54,.16));mix-blend-mode:screen}
.hero-image-shell img{filter:saturate(.78) contrast(1.08);transition:transform 1.4s var(--ease),filter .6s}.hero-image-shell:hover img{transform:scale(1.045);filter:saturate(1) contrast(1.05)}
.hero-chip{background:rgba(5,6,6,.82);border-color:rgba(216,255,54,.35);backdrop-filter:blur(14px)}.hero-chip span{color:var(--acid)}
.button--solid{background:var(--acid);color:#060706}.button--solid:hover{box-shadow:0 0 0 8px rgba(216,255,54,.12)}
.statement{position:relative}.statement h2{font-size:clamp(3.8rem,8.5vw,9rem);line-height:.88;letter-spacing:-.065em}.statement h2 em{color:#728400}
.statement-grid{border-top:1px solid rgba(0,0,0,.18);padding-top:30px}.statement-facts article{position:relative;overflow:hidden}.statement-facts article:before{content:"";position:absolute;inset:auto 0 0;height:2px;background:#101111;transform:scaleX(0);transform-origin:left;transition:.6s var(--ease)}.statement-facts article:hover:before{transform:scaleX(1)}
.cinema{background:#080909}.cinema-copy h2{font-size:clamp(4rem,9vw,9rem);line-height:.82}.cinema-copy h2 em{color:var(--acid);font-family:Georgia,serif;font-weight:400}.cinema-core{border-color:var(--acid);box-shadow:0 0 80px rgba(216,255,54,.12)}.cinema-core b{color:var(--acid)}
.services{background:var(--paper)}.services-head h2{font-size:clamp(3.5rem,7vw,7.5rem);line-height:.9}.service-tab{transition:transform .5s var(--ease),background .35s}.service-tab:hover{transform:translateX(10px)}.service-tab.is-active{background:#0a0b0b;color:white}.service-tab.is-active span,.service-tab.is-active i{color:var(--acid)}
.service-output{border-radius:2px;box-shadow:0 28px 70px rgba(0,0,0,.14)}.service-node{border-color:rgba(216,255,54,.5)}
.process{background:linear-gradient(180deg,#070808,#0c0e0d)}.process-left h2{font-size:clamp(3.6rem,6.7vw,7.1rem);line-height:.9}.process-core{border-color:var(--acid)}.process-core span{color:var(--acid)}.process-ring{border-color:rgba(216,255,54,.2)}.process-step{transition:.55s var(--ease)}.process-step.is-active{transform:translateX(-18px);border-color:var(--acid)}.process-step.is-active>span{color:var(--acid)}
.about{background:var(--paper)}.about-main-image,.about-side-image{overflow:hidden}.about-main-image img,.about-side-image img{transition:transform 1.1s var(--ease),filter .8s}.about-main-image:hover img,.about-side-image:hover img{transform:scale(1.04);filter:saturate(1.1)}.about-copy h2{font-size:clamp(3.7rem,7vw,7.5rem);line-height:.87}.about-copy h2 em{color:#738500;font-family:Georgia,serif;font-weight:400}
.contact{background:#050606;min-height:100vh}.contact-title{font-size:clamp(4.2rem,10vw,11rem);line-height:.77;letter-spacing:-.07em}.contact-title span:last-child{color:var(--acid);font-family:Georgia,serif;font-style:italic;font-weight:400}.contact-main{background:var(--acid);color:#050606;border-radius:999px;padding:22px 30px}.copy-email{border-color:rgba(216,255,54,.4)}
.reveal{will-change:transform,opacity}.section-index span{color:var(--acid)}.section-light .section-index span{color:#657600}
@media (max-width:900px){.hero{min-height:100svh}.hero-copy h1{font-size:clamp(4rem,16vw,7rem);line-height:.82}.hero-visual{opacity:.82}.hero-image-shell{transform:rotate(1deg)}.hero-sideword{display:none}.desktop-nav{display:none}.process-step.is-active{transform:none}.contact-title{font-size:16vw}}
@media (prefers-reduced-motion:reduce){.hero-aurora i{animation:none}.hero-image-shell img{transition:none}}
