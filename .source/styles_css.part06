@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}.intro{display:none}body.is-loading{overflow:auto}.cursor{display:none}}
.hero-line b{white-space:nowrap}
@media(max-width:620px){.hero h1{font-size:18.5vw}.hero-line--offset b{font-size:.94em}}


/* Cinematic v2 enhancement layer */
.hero-image-shell{transform-style:preserve-3d;transition:filter .35s ease}.hero-image-shell::before{content:"";position:absolute;inset:-18%;z-index:3;background:radial-gradient(circle at var(--spot-x,50%) var(--spot-y,50%),rgba(73,177,255,.26),transparent 22%);mix-blend-mode:screen;pointer-events:none;opacity:.8}.hero-image-shell img{object-position:center 18%;filter:saturate(.92) contrast(1.06)}
.hero-image-shell:hover img{filter:saturate(1.08) contrast(1.1)}
.hero-copy h1{perspective:900px}.hero-line b{transform-origin:50% 100%;will-change:transform}.hero-chip{backdrop-filter:blur(18px);transition:transform .35s ease,border-color .35s ease}.hero-chip:hover{transform:translateY(-6px) rotate(-1deg);border-color:rgba(77,183,255,.8)}

.cinema{height:430vh;position:relative;background:#050708;color:#f4f6f3}.cinema-sticky{position:sticky;top:0;height:100vh;overflow:hidden;isolation:isolate}.cinema-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:64px 64px;mask-image:radial-gradient(circle at center,#000 0,transparent 76%)}.cinema-sticky::before{content:"";position:absolute;inset:-15%;background:radial-gradient(circle at var(--cx,50%) var(--cy,50%),rgba(44,143,230,.22),transparent 24%),radial-gradient(circle at 78% 64%,rgba(255,111,31,.13),transparent 18%);filter:blur(12px)}
.cinema-copy{position:absolute;left:clamp(1rem,6vw,7rem);top:12vh;z-index:4;max-width:min(54rem,72vw)}.cinema-index{font-size:.64rem;letter-spacing:.16em;color:#63b9ff}.cinema-copy h2{margin:1.2rem 0 1rem;font-family:var(--display);font-size:clamp(4.8rem,11vw,11rem);line-height:.72;letter-spacing:-.06em;text-transform:uppercase}.cinema-copy h2 span{display:block;overflow:hidden}.cinema-copy p{max-width:31rem;color:#aeb5b4;line-height:1.7;font-size:.8rem}.cinema-orbit{position:absolute;left:58%;top:54%;width:min(48vw,680px);aspect-ratio:1;transform:translate(-50%,-50%);border:1px solid rgba(79,177,255,.18);border-radius:50%;box-shadow:0 0 100px rgba(34,127,211,.1)}.cinema-orbit::before,.cinema-orbit::after{content:"";position:absolute;border:1px dashed rgba(255,255,255,.14);border-radius:50%;inset:12%}.cinema-orbit::after{inset:28%;border-color:rgba(255,119,33,.3)}.cinema-orbit>i{position:absolute;width:18px;height:18px;border-radius:50%;background:#57baff;box-shadow:0 0 24px #57baff}.cinema-orbit>i:nth-child(1){left:48%;top:-9px}.cinema-orbit>i:nth-child(2){right:-9px;top:48%;background:#ff7a26;box-shadow:0 0 24px #ff7a26}.cinema-orbit>i:nth-child(3){left:48%;bottom:-9px}.cinema-orbit>i:nth-child(4){left:-9px;top:48%;background:#ff7a26;box-shadow:0 0 24px #ff7a26}.cinema-core{position:absolute;inset:36%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.25);background:rgba(8,12,15,.74);backdrop-filter:blur(16px);transform:rotate(45deg);box-shadow:0 0 90px rgba(57,167,255,.18)}.cinema-core>*{transform:rotate(-45deg)}.cinema-core b{font-family:var(--display);font-size:clamp(2.5rem,5vw,5.5rem)}.cinema-core span{position:absolute;bottom:14%;font-size:.48rem;letter-spacing:.15em;color:#74c6ff}.cinema-scenes{position:absolute;z-index:5;right:clamp(1rem,4vw,4rem);bottom:9vh;width:min(27rem,34vw)}.cinema-scenes article{position:absolute;right:0;bottom:0;width:100%;padding:1.2rem;border-top:1px solid rgba(255,255,255,.2);background:linear-gradient(90deg,rgba(8,11,13,.84),rgba(8,11,13,.35));backdrop-filter:blur(12px);opacity:0;transform:translateY(28px);transition:opacity .45s,transform .65s cubic-bezier(.16,1,.3,1)}.cinema-scenes article.is-active{opacity:1;transform:none}.cinema-scenes span{color:#ff7a26;font-size:.58rem}.cinema-scenes b{display:block;margin:.45rem 0;font-family:var(--display);font-size:2.2rem}.cinema-scenes p{margin:0;color:#a8afad;line-height:1.6;font-size:.7rem}.cinema-meter{position:absolute;z-index:6;left:clamp(1rem,6vw,7rem);bottom:6vh;display:grid;grid-template-columns:auto minmax(120px,18vw) auto;align-items:center;gap:1rem;font-size:.55rem;letter-spacing:.14em}.cinema-meter i{height:1px;background:rgba(255,255,255,.2)}.cinema-meter i b{display:block;height:100%;background:linear-gradient(90deg,#55b9ff,#ff7a26);transform-origin:left;transform:scaleX(0)}.cinema-meter strong{font-family:var(--display);font-size:1.3rem;color:#fff}

.project-screen{transition:transform .35s ease,box-shadow .35s ease;transform-style:preserve-3d}.project-screen:hover{box-shadow:0 36px 90px rgba(0,0,0,.48),0 0 55px rgba(51,157,232,.16)}.project-nav button{position:relative;overflow:hidden}.project-nav button::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:1px;background:#55b9ff;transform:scaleX(0);transform-origin:left;transition:transform .35s}.project-nav button:hover::after,.project-nav button.is-active::after{transform:scaleX(1)}
.service-tab{transition:transform .28s ease,background .28s ease}.service-tab:hover{transform:translateX(8px)}
.reveal.is-visible{filter:none}.reveal{filter:blur(8px)}
[data-depth]{will-change:transform}.kinetic-strip div{will-change:transform}

@media(max-width:899px){.cinema{height:330vh}.cinema-copy{top:10vh;max-width:92vw}.cinema-copy h2{font-size:18vw}.cinema-orbit{left:50%;top:56%;width:82vw}.cinema-scenes{left:1rem;right:1rem;bottom:12vh;width:auto}.cinema-meter{left:1rem;right:1rem;bottom:5vh;grid-template-columns:auto 1fr auto}.hero-image-shell img{object-position:62% 18%}}


/* ===== 2026 AWWWARDS-INSPIRED CREATIVE DIRECTION ===== */
:root{--acid:#d8ff36;--ink:#050606;--paper:#eef0e8;--muted:#9da29b;--line:rgba(255,255,255,.14);--ease:cubic-bezier(.16,1,.3,1)}
html{scrollbar-color:var(--acid) #070808}
body{background:var(--ink);font-feature-settings:"ss01" 1,"kern" 1}
::selection{background:var(--acid);color:#050606}
.site-header{mix-blend-mode:normal;background:linear-gradient(180deg,rgba(5,6,6,.82),transparent);backdrop-filter:blur(8px);padding-top:22px}
.brand{font-size:1.25rem;letter-spacing:-.08em}.brand span{color:var(--acid)}
.desktop-nav{border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:6px;background:rgba(255,255,255,.035)}
.desktop-nav a{padding:9px 15px;border-radius:999px;transition:.35s var(--ease)}
.desktop-nav a:hover,.desktop-nav a.is-active{background:var(--acid);color:#050606}
.header-contact{border-bottom-color:var(--acid)}
.scroll-progress i{background:var(--acid);box-shadow:0 0 16px rgba(216,255,54,.55)}
.hero{min-height:110vh;overflow:hidden;isolation:isolate}
