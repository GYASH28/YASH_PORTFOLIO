  <main id="main">
    <section class="hero" id="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="hero-sideword" aria-hidden="true">YASH / GANESH / 2026</div>
      <div class="hero-orbit orbit-one" aria-hidden="true"></div>
      <div class="hero-orbit orbit-two" aria-hidden="true"></div>
      <div class="hero-meta reveal">
        <span><i></i> Creative developer · AI systems builder</span>
        <span>Pune, India · Working worldwide</span>
      </div>

      <div class="hero-copy">
        <p class="hero-eyebrow reveal">DESIGN ENGINEERING · AI PRODUCTS · INTERACTION</p>
