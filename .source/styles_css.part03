.work{position:relative;background:#07090a}.work-intro{padding-top:8rem;padding-bottom:5rem}.work-intro h2{color:var(--white)}.work-intro h2 em{color:var(--orange)}.work-intro-copy{max-width:31rem;margin-left:auto;color:#a9adae;font-size:.8rem;line-height:1.7}.project-story{height:600vh}.project-stage{position:sticky;top:0;height:100svh;overflow:hidden;background:#080a0b}.project-stage-bg{position:absolute;inset:0;background:radial-gradient(circle at 30% 50%,rgba(57,167,255,.11),transparent 32%),radial-gradient(circle at 75% 60%,rgba(255,122,38,.08),transparent 35%)}.project-screen-wrap{position:absolute;left:5vw;top:10vh;width:56vw;height:72vh;perspective:1400px}.project-screen{position:absolute;inset:0;overflow:hidden;border:1px solid rgba(255,255,255,.16);background:#0b0d0f;box-shadow:0 35px 100px rgba(0,0,0,.55);transform:rotateY(4deg) rotateX(1deg);transition:transform .35s}.project-screen:hover{transform:rotateY(0) rotateX(0) scale(1.01)}.browser-bar{height:34px;display:flex;align-items:center;gap:.4rem;padding:0 .75rem;border-bottom:1px solid rgba(255,255,255,.12);background:rgba(8,10,11,.95)}.browser-bar i{width:6px;height:6px;border-radius:50%;background:#555b5e}.browser-bar span{margin-left:.5rem;color:#7d8385;font-size:.5rem;letter-spacing:.08em}.project-image-stack{position:absolute;left:0;right:0;top:34px;bottom:0}.project-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;opacity:0;transform:scale(1.08) translateY(3%);filter:blur(8px) saturate(.8);transition:opacity .7s,transform 1.2s cubic-bezier(.16,1,.3,1),filter .8s}.project-image.is-active{opacity:1;transform:scale(1) translateY(0);filter:blur(0) saturate(1)}.project-glitch{position:absolute;inset:34px 0 0;pointer-events:none;background:linear-gradient(transparent 0 49.5%,rgba(57,167,255,.12) 50%,transparent 50.5%);background-size:100% 8px;mix-blend-mode:screen;opacity:.18}.project-info{position:absolute;right:5vw;top:19vh;width:31vw}.project-counter{display:flex;align-items:center;gap:.8rem;color:#848a8d;font-family:var(--display);font-size:1.3rem}.project-counter span:first-child{color:var(--orange)}.project-counter i{width:70px;height:1px;background:#363c3e}.project-info>p:first-of-type{margin:2rem 0 .8rem;color:var(--blue-soft);font-size:.55rem;letter-spacing:.13em}.project-info h3{margin:0;font-family:var(--display);font-size:clamp(4rem,7vw,7.2rem);font-weight:600;line-height:.78;letter-spacing:-.045em;text-transform:uppercase}.project-info>p:nth-of-type(2){max-width:29rem;color:#b0b5b6;font-size:.78rem;line-height:1.75}.project-tags{display:flex;flex-wrap:wrap;gap:.45rem;margin:1.4rem 0}.project-tags span{padding:.45rem .55rem;border:1px solid rgba(255,255,255,.15);font-size:.5rem;letter-spacing:.08em}.case-open{display:flex;align-items:center;gap:.7rem;margin-top:1rem;padding:.8rem 1rem;border:1px solid var(--orange);background:none;color:var(--orange);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;transition:.25s}.case-open:hover{background:var(--orange);color:#08090a}.project-nav{position:absolute;left:5vw;right:5vw;bottom:2rem;display:grid;grid-template-columns:repeat(6,1fr);border-top:1px solid rgba(255,255,255,.14)}.project-nav button{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:.5rem;padding:.8rem .5rem;border:0;border-right:1px solid rgba(255,255,255,.1);background:none;color:#777d80;text-align:left;cursor:pointer;transition:.25s}.project-nav button:last-child{border-right:0}.project-nav button span{font-size:.5rem}.project-nav button b{font-family:var(--display);font-size:.95rem;font-weight:400}.project-nav button.is-active{color:#fff;background:rgba(255,255,255,.05)}.project-nav button.is-active span{color:var(--orange)}.project-progress{position:absolute;left:0;bottom:0;width:100%;height:2px;background:#1b2022}.project-progress i{display:block;width:100%;height:100%;background:linear-gradient(90deg,var(--blue),var(--orange));transform:scaleX(0);transform-origin:left}
.services{padding:9rem 0 10rem}.services-head>p:last-child{max-width:32rem;margin-left:auto;color:#4f5657;font-size:.82rem;line-height:1.7}.service-lab{display:grid;grid-template-columns:.8fr 1.6fr;margin-top:5rem}.service-tabs{display:grid;border:1px solid var(--line-dark);border-right:0}.service-tab{position:relative;display:grid;grid-template-columns:2rem 1fr auto;gap:.5rem;padding:1rem;border:0;border-bottom:1px solid var(--line-dark);background:transparent;color:#101314;text-align:left;cursor:pointer;overflow:hidden}.service-tab:last-child{border-bottom:0}.service-tab:before{content:"";position:absolute;inset:0;background:#0b0d0e;transform:translateX(-101%);transition:transform .45s cubic-bezier(.16,1,.3,1)}.service-tab>*{position:relative}.service-tab span{font-size:.55rem}.service-tab b{font-family:var(--display);font-size:1.9rem;font-weight:600;text-transform:uppercase}.service-tab small{grid-column:2;color:#626869;font-size:.58rem}.service-tab i{grid-column:3;grid-row:1/3;align-self:center;font-style:normal}.service-tab.is-active:before,.service-tab:hover:before{transform:none}.service-tab.is-active,.service-tab:hover{color:#fff}.service-tab.is-active small,.service-tab:hover small{color:#a8adae}.service-tab.is-active span{color:var(--orange)}.service-output{position:relative;min-height:570px;overflow:hidden;background:#0a0d0f;color:#fff}.service-output:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:42px 42px;mask-image:radial-gradient(circle at center,#000,transparent 80%)}#workflow-canvas{position:absolute;inset:0;width:100%;height:100%}.service-output-copy{position:relative;z-index:3;padding:2rem;max-width:75%}.service-output-copy>p:first-child{color:#8aaec4;font-size:.55rem;letter-spacing:.12em}.service-output-copy>p:first-child span{color:var(--orange)}.service-output-copy h3{max-width:700px;margin:1.5rem 0;font-family:var(--display);font-size:clamp(3.5rem,6vw,6rem);font-weight:600;line-height:.82;letter-spacing:-.04em;text-transform:uppercase}.service-output-copy>p:nth-of-type(2){max-width:580px;color:#aeb4b5;font-size:.74rem;line-height:1.7}.service-output-copy>div{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:1.5rem}.service-output-copy>div span{padding:.45rem .55rem;border:1px solid rgba(255,255,255,.15);font-size:.5rem;letter-spacing:.08em}.service-node{position:absolute;z-index:2;display:grid;place-items:center;width:92px;height:92px;border:1px solid rgba(57,167,255,.5);border-radius:50%;background:rgba(7,9,10,.8);box-shadow:0 0 35px rgba(57,167,255,.1);font-size:.5rem;letter-spacing:.08em}.service-node--one{left:12%;bottom:12%}.service-node--two{left:42%;bottom:20%;border-color:var(--orange);box-shadow:0 0 40px rgba(255,122,38,.14)}.service-node--three{right:19%;bottom:36%}.service-node--four{right:7%;bottom:9%}
