{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "bun install",
  "devCommand": "next dev",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/work/:slug", "destination": "/work/:slug" }
  ]
}
