{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/source/part1.txt", "destination": "https://raw.githubusercontent.com/GYASH28/YASH_PORTFOLIO/7532201e270386fff54533522f18288962ce6e21/.source/portfolio-source.gz.b64.part1" },
    { "source": "/source/part2.txt", "destination": "https://raw.githubusercontent.com/GYASH28/YASH_PORTFOLIO/7532201e270386fff54533522f18288962ce6e21/.source/portfolio-source.gz.b64.part2" },
    { "source": "/source/part3.txt", "destination": "https://raw.githubusercontent.com/GYASH28/YASH_PORTFOLIO/7532201e270386fff54533522f18288962ce6e21/.source/portfolio-source.gz.b64.part3" },
    { "source": "/assets/:path*", "destination": "https://raw.githubusercontent.com/GYASH28/YASH_PORTFOLIO/7532201e270386fff54533522f18288962ce6e21/assets/:path*" },
    { "source": "/system", "destination": "/index.html" },
    { "source": "/404", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/source/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
